# Where this app looks for the bills API — its root, not one endpoint. The
# client appends /restapi/BillDtos and /auth/* itself.
#
# Only needed if the API is not on its default port — src/api/client.js already
# falls back to the value below. Copy this file to .env to override it.
#
# Vite only exposes variables prefixed with VITE_, and it inlines them at build
# time: changing this after `npm run build` has no effect, and under Docker it is
# passed as a build arg rather than an environment variable (see the Dockerfile).
VITE_API_BASE_URL=http://localhost:5131
