# Installed fresh in the image by `npm ci`; copying a host node_modules in would
# both bloat the context and risk shipping binaries built for the wrong platform.
node_modules
dist
dist-ssr

# A local .env would silently override the VITE_API_BASE_URL build arg.
.env
.env.local
.env.*.local

*.log
.DS_Store
.vscode
.idea
