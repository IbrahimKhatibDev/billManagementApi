<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Still no PackageReferences. Bootstrap, Bootstrap Icons and open-iconic
       are vendored under wwwroot/css, so the app has no NuGet dependencies and
       makes no CDN requests at runtime.

       The one reference below is a project, not a package, and is deliberately
       to Contracts rather than to the API itself: referencing the API would
       drag EF Core, Npgsql and Swashbuckle into this process to reuse a handful
       of plain types. -->
  <ItemGroup>
    <ProjectReference Include="..\..\BillsMinimalApi.Contracts\BillsMinimalApi.Contracts.csproj" />
  </ItemGroup>

</Project>
