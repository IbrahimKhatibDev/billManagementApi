@inject NavigationManager Nav

@* The rail class lives on this element rather than on .page so that everything
   NavMenu.razor.css needs to know is inside NavMenu's own scope — otherwise the
   label/icon rules would have to reach up through the layout with ::deep. *@
<div class="nav-shell @(Railed ? "railed" : null)">

    <div class="nav-brand">
        <a class="nav-brand-link" href="" @onclick="HandleNavigate">
            <i class="bi bi-receipt-cutoff"></i>
            <span class="nav-label">Bills Manager</span>
        </a>

        <button type="button" class="nav-rail-toggle" @onclick="OnToggleRail"
                title="@RailToggleLabel" aria-label="@RailToggleLabel">
            <i class="bi @(Railed ? "bi-chevron-double-right" : "bi-chevron-double-left")"></i>
        </button>
    </div>

    <nav class="nav-links">
        @* title= is what keeps the collapsed rail usable: with the labels hidden
           the icon alone has to identify the destination, so hovering names it. *@
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All"
                 title="Dashboard" @onclick="HandleNavigate">
            <i class="bi bi-speedometer2"></i>
            <span class="nav-label">Dashboard</span>
        </NavLink>

        <NavLink class="nav-link" href="bills" title="Bills" @onclick="HandleNavigate">
            <i class="bi bi-receipt"></i>
            <span class="nav-label">Bills</span>
        </NavLink>

        <NavLink class="nav-link" href="reports" title="Reports" @onclick="HandleNavigate">
            <i class="bi bi-graph-up-arrow"></i>
            <span class="nav-label">Reports</span>
        </NavLink>
    </nav>

    <ThemeSwitcher />

    @* No <NotAuthorized> half: nothing renders this menu unless you are signed
       in, so the only case worth handling is the signed-in one. *@
    <AuthorizeView>
        <Authorized>
            <div class="nav-account">
                <div class="nav-account-user" title="@context.User.Identity?.Name">
                    <i class="bi bi-person-circle"></i>
                    <span class="nav-label">@context.User.Identity?.Name</span>
                </div>

                @* A button, not an anchor. Blazor's router intercepts same-origin
                   anchor clicks and looks for a matching component route — and
                   /Account/Logout is a Razor Page, not a component, so a link
                   there would render "nothing at this address" without ever
                   asking the server. forceLoad is what makes it a real
                   navigation. *@
                <button type="button" class="nav-signout" title="Sign out"
                        @onclick="@(() => Nav.NavigateTo("Account/Logout", forceLoad: true))">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="nav-label">Sign out</span>
                </button>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    /// <summary>Desktop only — collapses the sidebar to an icon rail.</summary>
    [Parameter]
    public bool Railed { get; set; }

    [Parameter]
    public EventCallback OnToggleRail { get; set; }

    /// <summary>Raised on every link click so the mobile drawer can close itself.
    /// On desktop the layout ignores it.</summary>
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private string RailToggleLabel => Railed ? "Expand sidebar" : "Collapse sidebar";

    private Task HandleNavigate() => OnNavigate.InvokeAsync();
}
