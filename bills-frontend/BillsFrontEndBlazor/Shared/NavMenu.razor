@* No collapse/toggle plumbing here any more — MudDrawer in MainLayout owns
   responsive behaviour, and a second mechanism fighting it produced the layout
   glitches the old Bootstrap navbar had on narrow screens. *@
<MudNavMenu Class="pa-2">
    <MudText Typo="Typo.overline" Class="px-4 pt-2 pb-1 mud-text-secondary">
        Navigation
    </MudText>

    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>

    <MudNavLink Href="bills" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">
        Bills
    </MudNavLink>
</MudNavMenu>
