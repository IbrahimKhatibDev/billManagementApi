@inherits LayoutComponentBase

<PageTitle>Bills Manager</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://github.com/IbrahimKhatibDev/billManagementApi" target="_blank" rel="noopener">
                <i class="bi bi-github me-1"></i> Source
            </a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@* One host for every toast the app raises. It lives outside @Body so a toast
   survives navigation between Dashboard and Bills. *@
<ToastHost />
