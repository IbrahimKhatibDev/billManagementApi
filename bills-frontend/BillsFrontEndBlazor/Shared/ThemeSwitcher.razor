@inject IJSRuntime JS

@* One control. This was a palette group beside a mode button, which offered
   four themes where the app only ever wanted two: dark is Nocturne, light is
   the scheme the app wore before the redesign. *@
<div class="theme-switcher">

    <button type="button" class="theme-mode" title="@ModeLabel" aria-label="@ModeLabel"
            @onclick="ToggleModeAsync">
        <i class="ph @(_mode == "dark" ? "ph-sun" : "ph-moon-stars")"></i>
    </button>

</div>

@code {
    // Seeded with the same default the markup and the boot script use, so the
    // prerendered button is not briefly wrong for a visitor who never changed
    // anything.
    private string _mode = "dark";

    private string ModeLabel => _mode == "dark" ? "Switch to light mode" : "Switch to dark mode";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // The first moment interop is available — the app prerenders on the
        // server, where IJSRuntime is not usable. The page is already wearing
        // the right theme by now; this only catches the button up with it.
        _mode = await JS.InvokeAsync<string>("billsTheme.read");

        StateHasChanged();
    }

    private async Task ToggleModeAsync()
    {
        _mode = _mode == "dark" ? "light" : "dark";

        // The script persists and applies in one call, so the key stays in one
        // place and the two can never drift apart.
        await JS.InvokeVoidAsync("billsTheme.save", _mode);
    }
}
