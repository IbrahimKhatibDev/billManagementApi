@* Idea 6. Sticky rather than fixed: it belongs to the list, so it rides at the
   top of the viewport while the list is long and settles above it when the
   list is short. *@
<div class="bar" role="status">

    <span class="label">@Count @(Count == 1 ? "bill" : "bills") selected</span>

    <span class="total">@Total.ToString("C")</span>

    @* The two buttons are wrapped so they can move as a pair: in a narrow column
       the bar folds onto two lines, and it is this span that takes the second
       one. Side by side they are laid out exactly as they were loose in the bar
       — same flex row, same gap — so the wide bar is unchanged. *@
    <span class="actions">

        <button type="button"
                class="pay"
                disabled="@(Busy || PayableCount == 0)"
                title="@(PayableCount == 0 ? "Every selected bill is already paid" : null)"
                @onclick="OnMarkPaid">
            @if (Busy)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <span>Marking…</span>
            }
            else
            {
                <span>Mark paid</span>
            }
        </button>

        @* Between the other verb and the escape hatch: the two things that act on
           the bills, then the one that lets go of them. It opens a confirmation
           rather than deleting, which is what makes it safe to sit next to
           Clear — the two are one slip apart, and only one of them can be taken
           back. *@
        <button type="button"
                class="delete"
                disabled="@Busy"
                @onclick="OnDelete">
            Delete
        </button>

        @* Not disabled while the batch runs: abandoning a selection you no longer
           want is always safe, and the writes already in flight are unaffected. *@
        <button type="button" class="clear" @onclick="OnClear">Clear</button>

    </span>

</div>

@code {
    [Parameter, EditorRequired]
    public int Count { get; set; }

    [Parameter, EditorRequired]
    public decimal Total { get; set; }

    /// <summary>
    /// How many of the selected bills are actually unpaid. Separate from
    /// <see cref="Count"/> so the button can go dead rather than spend a round
    /// trip writing Paid = true over Paid = true.
    /// </summary>
    [Parameter]
    public int PayableCount { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback OnMarkPaid { get; set; }

    /// <summary>
    /// Raised by the Delete button. Named for what the click asks for, not for
    /// what happens next: the page answers it by opening a confirmation, and
    /// nothing is deleted until that is agreed to.
    /// </summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    [Parameter]
    public EventCallback OnClear { get; set; }
}
