@* A second layout rather than reusing _Layout, for one reason: _Layout loads
   blazor.server.js. On a page with no Blazor components that script opens a
   SignalR circuit, finds nothing to render in it, and holds the connection open
   for the life of the page — a websocket per visitor sitting on the login
   screen, doing nothing. Everything else here is the same stylesheet set, so the
   account pages and the app proper look like one product. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    <title>@ViewData["Title"] · Bills Manager</title>

    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/bootstrap-icons/bootstrap-icons.min.css" />
    <link href="css/site.css" rel="stylesheet" />
</head>
<body class="account-body">
    <main class="account-shell">
        <div class="account-card">

            <div class="account-brand">
                <i class="bi bi-receipt-cutoff"></i>
                <span>Bills Manager</span>
            </div>

            @RenderBody()

        </div>
    </main>
</body>
</html>
