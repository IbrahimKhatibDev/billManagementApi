@page "/"

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Dashboard</MudText>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">
    Manage bills, track payments, and keep your finances organized.
</MudText>

@if (_loadFailed)
{
    <MudAlert Severity="Severity.Error" Class="mb-6">
        Could not reach the API.
        <MudButton Variant="Variant.Text"
                   Color="Color.Inherit"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadStatsAsync">
            Retry
        </MudButton>
    </MudAlert>
}

<MudGrid>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-5" Elevation="1">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.subtitle1" Class="ml-3 mud-text-secondary">Total Bills</MudText>
            </div>
            <MudText Typo="Typo.h3" Class="mt-3">
                <AnimatedCounter Value="@TotalBills" Format="N0" />
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-5" Elevation="1">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.subtitle1" Class="ml-3 mud-text-secondary">Paid</MudText>
            </div>
            <MudText Typo="Typo.h3" Class="mt-3">
                <AnimatedCounter Value="@PaidBills" Format="N0" />
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-5" Elevation="1">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Warning" Size="Size.Large" />
                <MudText Typo="Typo.subtitle1" Class="ml-3 mud-text-secondary">Outstanding</MudText>
            </div>
            @* Renders "$1,234.56" only because Program.cs pins en-US — the
               container's default culture is invariant, which formats "C" as ¤. *@
            <MudText Typo="Typo.h3" Class="mt-3">
                <AnimatedCounter Value="@OutstandingAmount" Format="C" />
            </MudText>
        </MudPaper>
    </MudItem>

    @* Inline SVG rendered from C# by MudBlazor: no JS interop (which is
       unusable during ServerPrerendered's first render), no CDN, no npm. *@
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-5" Elevation="1">
            <MudText Typo="Typo.h6" GutterBottom="true">Paid vs Unpaid</MudText>
            @if (TotalBills == 0)
            {
                <MudText Class="mud-text-secondary py-8">No bills to chart yet.</MudText>
            }
            else
            {
                <div class="d-flex flex-column align-center">
                    <MudChart T="double"
                              ChartType="ChartType.Donut"
                              Width="260px"
                              Height="260px"
                              ChartSeries="@_statusSeries"
                              ChartLabels="@_statusLabels">
                        @* Font sizes are in user units of the chart's own
                           viewBox ("0 0 280 280"), not pixels — MudBlazor's
                           older 40-unit donut viewBox is why samples elsewhere
                           use single-digit sizes here. *@
                        <CustomGraphics>
                            <text x="50%" y="46%"
                                  dominant-baseline="middle"
                                  text-anchor="middle"
                                  fill="currentColor"
                                  font-size="36"
                                  font-weight="500">
                                @PaidPercent.ToString("0")%
                            </text>
                            <text x="50%" y="57%"
                                  dominant-baseline="middle"
                                  text-anchor="middle"
                                  fill="currentColor"
                                  fill-opacity="0.6"
                                  font-size="15">
                                paid
                            </text>
                        </CustomGraphics>
                    </MudChart>
                </div>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-5" Elevation="1">
            <MudText Typo="Typo.h6" GutterBottom="true">Amount due by month</MudText>
            @if (TotalBills == 0)
            {
                <MudText Class="mud-text-secondary py-8">No bills to chart yet.</MudText>
            }
            else
            {
                <MudChart T="double"
                          ChartType="ChartType.Bar"
                          Height="300px"
                          ChartSeries="@_monthlySeries"
                          ChartLabels="@_monthLabels" />
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-5 d-flex flex-wrap gap-4 align-center" Elevation="1">
            <MudText Typo="Typo.subtitle1">Quick actions</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                       Href="bills">
                View all bills
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="_isLoading"
                       OnClick="LoadStatsAsync">
                Refresh
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>
