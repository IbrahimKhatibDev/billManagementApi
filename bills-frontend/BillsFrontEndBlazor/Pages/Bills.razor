@page "/bills"

<PageTitle>Bills</PageTitle>

@* The pager, sorting, filtering, loading overlay, empty state and the
   responsive stacked-card layout are all MudTable features — none of it is
   hand-rolled. It does not, however, rewind the pager when Filter's output
   shrinks; it only clamps, so filtering from page 3 lands you on the *last*
   page of the new result set. SearchText/PaidFilter below call NavigateTo to
   fix that. *@
<MudTable T="Bill"
          @ref="_table"
          Items="_bills"
          Filter="new Func<Bill, bool>(MatchesFilters)"
          Loading="_isLoading"
          LoadingProgressColor="Color.Primary"
          Breakpoint="Breakpoint.Sm"
          Hover="true"
          Striped="true"
          Elevation="1"
          RowsPerPage="10">

    <ToolBarContent>
        <MudText Typo="Typo.h5">Bills</MudText>

        <MudSpacer />

        <MudTextField @bind-Value="SearchText"
                      Immediate="true"
                      DebounceInterval="200"
                      Placeholder="Search id or payee"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Clearable="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mt-0 mr-4"
                      Style="max-width: 260px;" />

        <MudToggleGroup T="PaidFilter"
                        @bind-Value="PaidFilterValue"
                        Color="Color.Primary"
                        Size="Size.Small"
                        CheckMark="false"
                        Class="mr-4">
            <MudToggleItem T="PaidFilter" Value="@PaidFilter.All" Text="All" />
            <MudToggleItem T="PaidFilter" Value="@PaidFilter.Paid" Text="Paid" />
            <MudToggleItem T="PaidFilter" Value="@PaidFilter.Unpaid" Text="Unpaid" />
        </MudToggleGroup>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialogAsync">
            New Bill
        </MudButton>
    </ToolBarContent>

    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<Bill, object>(x => x.Id)" InitialDirection="SortDirection.Ascending">
                ID
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<Bill, object>(x => x.PayeeName)">Payee</MudTableSortLabel>
        </MudTh>
        <MudTh>
            @* DueDate is nullable; coalescing to MaxValue keeps undated bills
               sorted last instead of first. *@
            <MudTableSortLabel SortBy="new Func<Bill, object>(x => x.DueDate ?? DateTime.MaxValue)">
                Due Date
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<Bill, object>(x => x.PaymentDue)">Amount</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<Bill, object>(x => x.Paid)">Status</MudTableSortLabel>
        </MudTh>
        <MudTh Style="text-align: right;">Actions</MudTh>
    </HeaderContent>

    @* DataLabel is what makes the stacked mobile cards readable — below the
       Sm breakpoint MudTable drops the header row and prints these instead. *@
    <RowTemplate>
        <MudTd DataLabel="ID">@context.Id</MudTd>
        <MudTd DataLabel="Payee">@context.PayeeName</MudTd>
        <MudTd DataLabel="Due Date">
            @(context.DueDate?.ToString("d") ?? "—")
        </MudTd>
        <MudTd DataLabel="Amount">@context.PaymentDue.ToString("C")</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Color="@(context.Paid ? Color.Success : Color.Warning)">
                @(context.Paid ? "Paid" : "Unpaid")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Actions" Style="text-align: right;">
            <MudTooltip Text="Edit">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               aria-label="@($"Edit bill {context.Id}")"
                               OnClick="@(() => OpenEditDialogAsync(context))" />
            </MudTooltip>
            <MudTooltip Text="Delete">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               aria-label="@($"Delete bill {context.Id}")"
                               OnClick="@(() => ConfirmDeleteAsync(context))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        @if (_loadFailed)
        {
            <div class="d-flex flex-column align-center py-8">
                <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" Color="Color.Error" />
                <MudText Class="my-3">Could not reach the API.</MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadBillsAsync">
                    Retry
                </MudButton>
            </div>
        }
        else if (_bills.Count == 0)
        {
            <MudText Class="py-6">No bills yet. Use “New Bill” to add one.</MudText>
        }
        else
        {
            <MudText Class="py-6">No bills match the current search or filter.</MudText>
        }
    </NoRecordsContent>

    <LoadingContent>
        <MudText Class="py-6">Loading bills…</MudText>
    </LoadingContent>

    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudTable>
