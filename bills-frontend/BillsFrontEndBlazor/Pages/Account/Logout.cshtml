@page
@model BillsFrontEndBlazor.Pages.Account.LogoutModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Sign out";
}

<h1 class="account-title">Sign out?</h1>
<p class="account-subtitle">
    @if (Model.Email is { Length: > 0 })
    {
        <text>You are signed in as <strong>@Model.Email</strong>.</text>
    }
    else
    {
        <text>You are not signed in at the moment.</text>
    }
</p>

@* A confirmation screen rather than signing out on arrival, because a GET that
   changes state can be triggered by anything that fetches a URL — an image tag on
   another site is enough to log someone out. The POST below carries an
   antiforgery token, which is the actual protection; this page exists so there is
   somewhere to render that token from. A Blazor component could not: inside a
   live circuit there is no HttpContext to issue one against. *@
<form method="post">
    <button type="submit" class="btn btn-primary w-100">
        <i class="bi bi-box-arrow-right me-1"></i> Yes, sign me out
    </button>
</form>

<p class="account-alt">
    <a href="~/">Never mind, take me back</a>
</p>
