@page
@model BillsFrontEndBlazor.Pages.Account.RegisterModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Create an account";
}

<h1 class="account-title">Create an account</h1>
<p class="account-subtitle">You start with an empty list. Nobody else can see it.</p>

@if (Model.Errors.Count > 0)
{
    <div class="alert alert-danger py-2 px-3 mb-3" role="alert">
        @foreach (var error in Model.Errors)
        {
            <div><i class="ph ph-warning me-1"></i> @error</div>
        }
    </div>
}

<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="mb-3">
        <label class="form-label" asp-for="Input.Email">Email</label>
        <div class="input-group">
            <span class="input-group-text"><i class="ph ph-envelope-simple"></i></span>
            <input class="form-control" asp-for="Input.Email" type="email"
                   autocomplete="username" autofocus placeholder="you@example.com" />
        </div>
        <span class="text-danger small" asp-validation-for="Input.Email"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Input.Password">Password</label>
        <div class="input-group">
            <span class="input-group-text"><i class="ph ph-lock-simple"></i></span>
            <input class="form-control" asp-for="Input.Password" type="password"
                   autocomplete="new-password" placeholder="At least 8 characters" />
        </div>
        <span class="text-danger small" asp-validation-for="Input.Password"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Input.ConfirmPassword">Confirm password</label>
        <div class="input-group">
            <span class="input-group-text"><i class="ph ph-lock-key"></i></span>
            <input class="form-control" asp-for="Input.ConfirmPassword" type="password"
                   autocomplete="new-password" placeholder="Type it again" />
        </div>
        <span class="text-danger small" asp-validation-for="Input.ConfirmPassword"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">
        <i class="ph ph-user-plus me-1"></i> Create account
    </button>
</form>

<p class="account-alt">
    Already have one? <a asp-page="Login" asp-route-ReturnUrl="@Model.ReturnUrl">Sign in</a>
</p>
