@using Microsoft.AspNetCore.Components.Web
@namespace BillsFrontEndBlazor.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    @* MudBlazor replaces Bootstrap entirely. Both ship a CSS reset, so loading
       them together makes them fight over the same elements. Everything below is
       served from this app — there are no CDN or third-party requests. *@
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
    @* No BillsFrontEndBlazor.styles.css link: the scoped-CSS bundle is only
       emitted when the project has .razor.css files, and MudDrawer/MudNavMenu
       replaced the two that existed. Linking it anyway is a guaranteed 404. *@

    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    @* Must come after blazor.server.js. *@
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>
