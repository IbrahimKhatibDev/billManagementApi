@using Microsoft.AspNetCore.Components.Web
@namespace BillsFrontEndBlazor.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    @* Everything below is served from this app — there are no CDN or other
       third-party requests. Bootstrap Icons is vendored under
       wwwroot/css/bootstrap-icons/ rather than pulled from jsdelivr, so the
       container stays self-contained and the UI renders with the network off. *@
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/bootstrap-icons/bootstrap-icons.min.css" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="BillsFrontEndBlazor.styles.css" rel="stylesheet" />

    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    @* No Bootstrap JS bundle. The modals and toasts in this app are plain
       Blazor conditional rendering plus Bootstrap's own classes, so nothing
       here needs a JS component to drive it. *@
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
