@using Microsoft.AspNetCore.Components.Web
@namespace BillsFrontEndBlazor.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en" data-mode="dark" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    @* Everything below is served from this app — there are no CDN or other
       third-party requests. Phosphor is vendored under wwwroot/css/phosphor/
       rather than pulled from jsdelivr, so the container stays self-contained
       and the UI renders with the network off. *@
    @* theme.js is blocking and first: it sets data-mode before anything paints.
       The attribute is in the markup above as well, so the page is Nocturne
       dark rather than unthemed when scripting is off.

       asp-append-version on the three files this app actually edits. Nothing
       here sends Cache-Control, so a browser is free to keep its copy across a
       deploy — and a stale theme.js is not a cosmetic problem: ThemeSwitcher
       calls billsTheme.read() expecting a string, and an older build that
       returned an object takes the whole circuit down with it. The hash in the
       URL changes when the bytes do, so there is nothing stale to serve.
       Bootstrap and Phosphor are vendored and frozen, so they keep plain
       URLs. *@
    <script src="js/theme.js" asp-append-version="true"></script>

    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/phosphor/style.css" />
    <link href="css/tokens.css" rel="stylesheet" asp-append-version="true" />
    <link href="css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="BillsFrontEndBlazor.styles.css" rel="stylesheet" />

    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    @* No Bootstrap JS bundle. The modals and toasts in this app are plain
       Blazor conditional rendering plus Bootstrap's own classes, so nothing
       here needs a JS component to drive it. *@
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
