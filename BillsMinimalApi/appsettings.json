{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=billdb;Username=bills;Password=bills_dev_password"
  },
  "Jwt": {
    "Issuer": "BillsMinimalApi",
    "Audience": "BillsMinimalApi",
    "LifetimeMinutes": 60,

    "//SigningKey": "Left empty on purpose — a signing key in source control is a signing key everybody has. Supply it as the Jwt__SigningKey environment variable (docker-compose.yml sets one for the demo stack). Outside Development an empty key fails startup; in Development, Program.cs generates a throwaway one per run.",
    "SigningKey": ""
  },
  "//Logging": "The Logging:LogLevel section is gone on purpose. Serilog is the logging provider now (see Logging/LoggingSetup.cs), and leaving both in place gives two sets of level rules that both apply — the quietest wins, and working out which one silenced a message is a bad afternoon. Levels live under Serilog:MinimumLevel below; sinks are set in code.",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // The framework's own per-request lines. Suppressed because
        // UseSerilogRequestLogging already emits one summary line per request
        // carrying the same facts; this override is what makes that a
        // replacement rather than an addition.
        "Microsoft.AspNetCore": "Warning",

        // Every SQL statement EF sends, logged at Information by default. Left
        // off because /health/ready runs a query every ten seconds under
        // docker compose. Set this to "Information" to watch the SQL that
        // BillQueryable builds.
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",

        // Kept, unlike the rest of Microsoft.*: this is the category that says
        // which URLs the app is listening on and that it is shutting down.
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },

  // Defaults live in RateLimiting/RateLimitOptions.cs; these repeat them so the
  // numbers in force are visible without reading code, and so a deployment can
  // move them with RateLimiting__Auth__PermitLimit and friends. Counted per
  // client IP, per instance — see RateLimitSetup for what that means behind a
  // load balancer.
  "RateLimiting": {
    // Sign-in and registration only. Ten a minute is generous for a person
    // mistyping a password and hopeless for anything working through a list.
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },

    // Everything else, health probes excepted. The bills table issues a handful
    // of requests per page view, so 300 a minute is far above what using the app
    // costs and far below what scripting it does.
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },

  "AllowedHosts": "*"
}
